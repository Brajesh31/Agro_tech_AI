# Copy this file to the relevant service directory as .env.
# Never commit real credentials. Each service may require only a subset.

# Primary Node.js backend
MONGODB_URL=mongodb://localhost:27017/agrotech
GEMINI_API_KEY=
JWT_SECRET=replace-with-a-long-random-value
ENCRYPTION_SECRET_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
EMAIL_USER=
EMAIL_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
VITE_BACKEND_BASE_URL=http://localhost:8080
VITE_MAPBOX_ACCESS_TOKEN=

# Flask/ML services
GOOGLE_API_KEY=
GROQ_API_KEY=
