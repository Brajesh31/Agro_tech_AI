# Backend runtime
PORT=8080
NODE_ENV=development

# MongoDB
MONGODB_URL=

# Authentication: generate a unique high-entropy value for each environment
JWT_SECRET=
SESSION_SECRET=

# Google / Gemini
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
SMTP_EMAIL=
SMTP_PASSWORD=
EMAIL_USER=
EMAIL_PASS=

# Encryption: use a cryptographically random key matching the middleware's required length
ENCRYPTION_SECRET_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Configure allowed frontend origins in the backend's CORS policy
FRONTEND_ORIGIN=http://localhost:5173
